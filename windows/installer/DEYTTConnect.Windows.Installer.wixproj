<Project Sdk="WixToolset.Sdk/6.0.0">
  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>ru-RU</Cultures>
    <DefineConstants>$(DefineConstants);PackageStageDir=$(PackageStageDir);ProductVersion=$(ProductVersion);SetupProductCode=$(SetupProductCode)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.0" />
    <ProjectReference Include="CustomActions/DeyttConnect.SetupActions.csproj" />
  </ItemGroup>
</Project>
