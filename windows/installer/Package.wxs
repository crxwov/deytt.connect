<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Id="DEYTT.Connect.Windows"
           Name="deytt connect"
           Manufacturer="DEYTT"
           Language="1049"
           Version="$(var.ProductVersion)"
           Scope="perMachine">
    <Icon Id="DeyttConnectProductIcon.exe" SourceFile="$(var.PackageStageDir)/DeyttConnect.Windows.exe" />
    <Property Id="ARPPRODUCTICON" Value="DeyttConnectProductIcon.exe" />
    <MajorUpgrade Schedule="afterInstallInitialize" IgnoreLanguage="yes" DowngradeErrorMessage="на компьютере уже установлена более новая версия deytt connect." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ALLOWEDUSERSID" Secure="yes">
      <RegistrySearch Id="FindExistingAllowedUserSid"
                      Root="HKLM"
                      Key="SOFTWARE\DEYTT\Connect"
                      Name="AllowedUserSid"
                      Type="raw" />
    </Property>
    <SetProperty Id="ALLOWEDUSERSID" Value="[UserSID]" Before="LaunchConditions"
                 Sequence="both" Condition="NOT ALLOWEDUSERSID" />
    <Property Id="EXISTING_SERVICE_PATH" Secure="yes">
      <RegistrySearch Id="FindExistingVpnService"
                      Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\DEYTTConnectVpn"
                      Name="ImagePath"
                      Type="raw" />
    </Property>

    <Property Id="CONNECT_SERVICE_COMPATIBLE" Secure="yes" />
    <Property Id="WEBVIEW2_PRESENT" Secure="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="DEYTT Connect — приложение и служба VPN. Данные входа сохраняются при обновлении и удалении." />
    <Binary Id="SetupActions" SourceFile="$(var.DeyttConnect.SetupActions.TargetDir)DeyttConnect.SetupActions.CA.dll" />
    <CustomAction Id="DetectLegacyService" BinaryRef="SetupActions" DllEntry="DetectLegacyService" Execute="immediate" Return="check" />
    <CustomAction Id="ValidateInstallDirectory" BinaryRef="SetupActions" DllEntry="ValidateInstallDirectory" Execute="immediate" Return="check" />
    <CustomAction Id="FinishSetup" BinaryRef="SetupActions" DllEntry="FinishSetup" Execute="immediate" Return="check" />
    <CustomAction Id="PrepareWebView2" BinaryRef="SetupActions" DllEntry="PrepareWebView2" Execute="immediate" Return="check" />
    <CustomAction Id="InstallWebView2" BinaryRef="SetupActions" DllEntry="InstallWebView2" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="PrepareShortcutRemoval" BinaryRef="SetupActions" DllEntry="PrepareShortcutRemoval" Execute="immediate" Return="check" />
    <CustomAction Id="RemoveDesktopShortcut" BinaryRef="SetupActions" DllEntry="RemoveDesktopShortcut" Execute="deferred" Impersonate="yes" Return="check" />
    <InstallUISequence>
      <Custom Action="DetectLegacyService" After="AppSearch" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="DetectLegacyService" After="AppSearch" />
      <Custom Action="ValidateInstallDirectory" Before="InstallInitialize" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="PrepareWebView2" Before="InstallWebView2" Condition="NOT REMOVE~=&quot;ALL&quot; AND NOT WEBVIEW2_PRESENT" />
      <Custom Action="InstallWebView2" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot; AND NOT WEBVIEW2_PRESENT" />
      <Custom Action="PrepareShortcutRemoval" Before="RemoveDesktopShortcut" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveDesktopShortcut" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <Property Id="WINDOWS_BUILD"><RegistrySearch Id="FindWindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" /></Property>
    <UIRef Id="DeyttSetupUI" />
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWS_BUILD &gt;= 17763)"
            Message="deytt connect требует 64-разрядную windows 10 версии 1809 или более новую windows." />
    <Launch Condition="ALLOWEDUSERSID &gt;&lt; &quot;S-1-&quot;"
            Message="не удалось определить учётную запись windows. запустите установщик из учётной записи, в которой будете пользоваться приложением." />
    <Launch Condition="NOT EXISTING_SERVICE_PATH OR CONNECT_SERVICE_COMPATIBLE = &quot;1&quot; OR REMOVE~=&quot;ALL&quot;"
            Message="служба deyttconnectvpn указывает на другое приложение. установка остановлена, чтобы не повредить его. обратитесь в поддержку deytt." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="DEYTTDIR" Name="DEYTT">
        <Directory Id="INSTALLFOLDER" Name="Connect">
          <Directory Id="PREREQUISITESFOLDER" Name="Prerequisites">
            <Component Id="WebViewBootstrapperComponent" Guid="DFD5C59A-705F-434A-A676-0D4B9273C5BB" Bitness="always64">
              <File Id="WebViewBootstrapper" Source="$(var.PackageStageDir)/Prerequisites/MicrosoftEdgeWebview2Setup.exe" KeyPath="yes" />
            </Component>
          </Directory>
          <Component Id="VpnServiceComponent" Guid="7AC61332-77E2-4B5A-B098-16BD7EC4C621" Bitness="always64">
            <File Id="VpnServiceExecutable"
                  Source="$(var.PackageStageDir)/DeyttConnect.Windows.Service.exe"
                  KeyPath="yes" />
            <ServiceInstall Id="VpnServiceInstall"
                            Name="DEYTTConnectVpn"
                            DisplayName="deytt connect vpn"
                            Description="runs the deytt connect windows vpn tunnel."
                            Type="ownProcess"
                            Start="auto"
                            ErrorControl="normal"
                            Account="LocalSystem"
                            Arguments="--service" />
            <ServiceControl Id="VpnServiceControl"
                            Name="DEYTTConnectVpn"
                            Start="install"
                            Stop="both"
                            Remove="both"
                            Wait="yes" />
          </Component>

          <Component Id="AllowedUserSidComponent" Guid="9F38881C-88D8-4A09-B682-94A2CF4BE8CC" Bitness="always64">
            <RegistryValue Root="HKLM"
                           Key="SOFTWARE\DEYTT\Connect"
                           Name="AllowedUserSid"
                           Type="string"
                           Value="[ALLOWEDUSERSID]"
                           KeyPath="yes" />
          </Component>

          <Component Id="UiExecutableComponent" Guid="F58356B8-3B93-445A-B003-F5E1E863B435" Bitness="always64">
            <File Id="UiExecutable"
                  Source="$(var.PackageStageDir)/DeyttConnect.Windows.exe"
                  KeyPath="yes">
              <Shortcut Id="UiStartMenuShortcut"
                        Advertise="yes"
                        Directory="ApplicationProgramsFolder"
                        Name="deytt connect"
                      Icon="DeyttConnectProductIcon.exe"
                      IconIndex="0"
                        WorkingDirectory="INSTALLFOLDER" />
            </File>
            <RemoveFolder Id="RemoveApplicationProgramsFolder"
                          Directory="ApplicationProgramsFolder"
                          On="uninstall" />
          </Component>

        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="deytt connect" Level="1">
      <ComponentRef Id="VpnServiceComponent" />
      <ComponentRef Id="AllowedUserSidComponent" />
      <ComponentRef Id="UiExecutableComponent" />
      <ComponentRef Id="WebViewBootstrapperComponent" />
      <ComponentGroupRef Id="PayloadFiles" />
    </Feature>
  </Package>
  <Fragment>
    <ComponentGroup Id="PayloadFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PackageStageDir)/**">
        <Exclude Files="$(var.PackageStageDir)/DeyttConnect.Windows.Service.exe" />
        <Exclude Files="$(var.PackageStageDir)/DeyttConnect.Windows.exe" />
        <Exclude Files="$(var.PackageStageDir)/Prerequisites/MicrosoftEdgeWebview2Setup.exe" />
      </Files>
    </ComponentGroup>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="deytt connect" />
    </StandardDirectory>
  </Fragment>
</Wix>
