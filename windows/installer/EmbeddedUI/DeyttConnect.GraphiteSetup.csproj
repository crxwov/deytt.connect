<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platform>x64</Platform>
    <AssemblyName>DeyttConnect.GraphiteSetup</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="6.0.0" />
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" Version="6.0.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="../CustomActions/DeyttConnect.SetupActions.csproj" />
    <Content Include="EmbeddedUI.config" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\DeyttConnect.Windows\Assets\deyttconnect.ico" LogicalName="deyttconnect.ico" />
  </ItemGroup>
</Project>
