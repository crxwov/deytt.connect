<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.10.6</Version>
    <AssemblyVersion>0.10.6.0</AssemblyVersion>
    <FileVersion>0.10.6.0</FileVersion>
    <InformationalVersion>0.10.6</InformationalVersion>
    <AssemblyTitle>deytt./connect</AssemblyTitle>
    <Company>deytt.</Company>
    <Product>deytt./connect</Product>
    <Description>deytt./connect for Windows</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\deyttconnect.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\DeyttConnect.Windows.Service\RouteLatencyProbe.cs" Link="Shared\RouteLatencyProbe.cs" />
    <Folder Include="Models\" />
    <Content Include="Assets\deyttconnect.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\DeyttConnect.Protocol\DeyttConnect.Protocol.csproj" />
    <Compile Include="..\DeyttConnect.Shared\WindowsAwgProfileParser.cs" Link="Shared\WindowsAwgProfileParser.cs" />
    <AvaloniaResource Include="Assets\**" Exclude="Assets\route-map\**" />
    <Content Include="..\..\app\src\main\assets\route-map\**\*"
             Link="Assets\route-map\%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\..\app\src\main\assets\route-map\index.html;..\..\app\src\main\assets\route-map\network-atlas.css;..\..\app\src\main\assets\route-map\atlas-init.js;..\..\app\src\main\assets\route-map\network-atlas.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\route-map\index.html;Assets\route-map\network-atlas.css;Assets\route-map\atlas-init.js;Assets\route-map\network-atlas.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\ProtocolMarks\amnezia-mark.svg"
             Link="Assets\route-map\protocol-marks\amnezia-mark.svg"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\ProtocolMarks\hysteria-symbol.svg"
             Link="Assets\route-map\protocol-marks\hysteria-symbol.svg"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\ProtocolMarks\vless-star-symbol.svg"
             Link="Assets\route-map\protocol-marks\vless-star-symbol.svg"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\ProtocolMarks\trojan-diamond-symbol.svg"
             Link="Assets\route-map\protocol-marks\trojan-diamond-symbol.svg"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\InterTight-Regular.ttf;Assets\Fonts\InterTight-SemiBold.ttf;Assets\Fonts\InterTight-Bold.ttf;Assets\Fonts\Unbounded-Bold.ttf;Assets\Fonts\JetBrainsMono-Regular.ttf"
             Link="Assets\route-map\fonts\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\app\src\main\assets\world-land.json"
             Link="Assets\route-map\world-land.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\scripts\Install-VpnService.ps1" Link="Install-VpnService.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\scripts\Uninstall-VpnService.ps1" Link="Uninstall-VpnService.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.Documents" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <!-- Avalonia hosts WebView2 through its Core API; the WPF wrapper is unused and
         conflicts with WindowsBase from the .NET target framework. -->
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
