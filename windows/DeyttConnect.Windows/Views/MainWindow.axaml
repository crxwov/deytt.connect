<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DeyttConnect.Windows.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="DeyttConnect.Windows.Views.MainWindow"
        Icon="/Assets/deyttconnect.ico"
        Title="./connect"
        WindowDecorations="None"
        CanResize="True"
        CanMinimize="True"
        CanMaximize="True"
        ShowInTaskbar="True"
        Width="1240"
        Height="800"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#080D17">

    <Grid x:Name="ShellGrid" ColumnDefinitions="*,0" RowDefinitions="Auto,*,0" Background="#080D17">
        <Grid x:Name="WorkspaceColumn" Grid.Column="0" Grid.RowSpan="2" RowDefinitions="0,*">
            <ScrollViewer x:Name="PageScroll" Grid.Row="0" Grid.RowSpan="2" BringIntoViewOnFocusChange="True"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="PageHost" MaxWidth="1920" HorizontalAlignment="Center"
                      Margin="0" />
            </ScrollViewer>

            <Border x:Name="WorkspaceHeader" Grid.Row="0" Grid.RowSpan="2" Height="68" Padding="36,0,36,0"
                    VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar">
                <Grid x:Name="HeaderContentGrid" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock x:Name="WorkspaceBrand" FontFamily="fonts:DEYTT#Unbounded"
                               FontSize="23" FontWeight="ExtraBold" Foreground="#FFFFFF"
                               VerticalAlignment="Center" chrome:WindowDecorationProperties.ElementRole="TitleBar">
                        <Run Text="./" Foreground="#38BDF8" /><Run Text="connect" />
                    </TextBlock>

                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border x:Name="HeaderDragRegion" Background="Transparent"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                chrome:WindowDecorationProperties.ElementRole="TitleBar" />

                        <Border x:Name="NavDockBorder" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="20" Background="#B20B1220" BorderBrush="#26FFFFFF"
                                BorderThickness="1" Padding="4"
                                BoxShadow="0 4 20 0 #40000000"
                                chrome:WindowDecorationProperties.ElementRole="User">
                            <StackPanel x:Name="HeaderNavigation" Orientation="Horizontal"
                                        Spacing="4" VerticalAlignment="Center">
                                <Button x:Name="TopHomeNav" Classes="deytt-button nav-pill" MinHeight="36"
                                        chrome:WindowDecorationProperties.ElementRole="User" />
                                <Button x:Name="TopRoutesNav" Classes="deytt-button nav-pill" MinHeight="36"
                                        chrome:WindowDecorationProperties.ElementRole="User" />
                                <Button x:Name="TopProfileNav" Classes="deytt-button nav-pill" MinHeight="36"
                                        chrome:WindowDecorationProperties.ElementRole="User" />
                                <Button x:Name="TopSettingsNav" Classes="deytt-button nav-pill" MinHeight="36"
                                        chrome:WindowDecorationProperties.ElementRole="User" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="WindowChromeActions" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ThemeToggleButton" Classes="deytt-button chrome-button"
                                Width="38" Height="38" CornerRadius="12" IsVisible="False"
                                ToolTip.Tip="сменить тему" AutomationProperties.Name="сменить тему"
                                chrome:WindowDecorationProperties.ElementRole="User" />
                        <Button x:Name="MinimizeWindowButton" Classes="deytt-button chrome-button"
                                Width="38" Height="38" CornerRadius="12"
                                ToolTip.Tip="свернуть" AutomationProperties.Name="свернуть"
                                chrome:WindowDecorationProperties.ElementRole="User" />
                        <Button x:Name="MaximizeWindowButton" Classes="deytt-button chrome-button"
                                Width="38" Height="38" CornerRadius="12"
                                ToolTip.Tip="развернуть" AutomationProperties.Name="развернуть"
                                chrome:WindowDecorationProperties.ElementRole="User" />
                        <Button x:Name="CloseWindowButton" Classes="deytt-button chrome-button close-button"
                                Width="38" Height="38" CornerRadius="12"
                                ToolTip.Tip="закрыть" AutomationProperties.Name="закрыть"
                                chrome:WindowDecorationProperties.ElementRole="User" />
                    </StackPanel>

                    <Grid x:Name="LegacyHeaderState" IsVisible="False">
                        <TextBlock x:Name="WorkspaceEyebrow" Text="./connect" />
                        <TextBlock x:Name="WorkspaceTitle" Text="подключение" />
                        <TextBlock x:Name="HeaderStatusText" Text="не подключено" />
                        <Ellipse x:Name="HeaderStatusDot" Width="1" Height="1" />
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer x:Name="PageScroll" Grid.Row="1" BringIntoViewOnFocusChange="True"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="PageHost" MaxWidth="1360" HorizontalAlignment="Center"
                      Margin="64,40,64,32" />
            </ScrollViewer>
        </Grid>

        <!-- The old navigation controls remain hidden so existing modal focus and automation paths stay valid. -->
        <Border x:Name="SidebarPanel" Grid.Column="1" Grid.RowSpan="2" IsVisible="False">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid x:Name="SidebarBrandRow"><Border x:Name="SidebarBrandMark"><TextBlock Text="d" /></Border>
                    <StackPanel x:Name="SidebarBrandCopy"><TextBlock Text="deytt." /></StackPanel></Grid>
                <StackPanel x:Name="NavSectionHeader" Grid.Row="1"><TextBlock x:Name="NavSectionTitle" /></StackPanel>
                <StackPanel x:Name="SidebarNavPanel" Grid.Row="2">
                    <Button x:Name="HomeNav" Classes="deytt-button" />
                    <Button x:Name="RoutesNav" Classes="deytt-button" />
                    <Button x:Name="ProfileNav" Classes="deytt-button" />
                    <Button x:Name="SettingsNav" Classes="deytt-button" />
                </StackPanel>
                <Border x:Name="SidebarStatusCard" Grid.Row="3"><Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <Ellipse x:Name="SidebarStatusDot" Width="1" Height="1" />
                    <TextBlock x:Name="SidebarVpnText" Grid.Column="1" />
                    <TextBlock x:Name="SidebarAccountText" Grid.Column="1" Grid.Row="1" />
                </Grid></Border>
            </Grid>
        </Border>

        <Border Grid.ColumnSpan="2" Grid.RowSpan="3" Height="5" VerticalAlignment="Top"
                Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="ResizeN" />
        <Border Grid.ColumnSpan="2" Grid.RowSpan="3" Height="5" VerticalAlignment="Bottom"
                Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="ResizeS" />
        <Border Grid.ColumnSpan="2" Grid.RowSpan="3" Width="5" HorizontalAlignment="Left"
                Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="ResizeW" />
        <Border Grid.ColumnSpan="2" Grid.RowSpan="3" Width="5" HorizontalAlignment="Right"
                Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="ResizeE" />
        <Border Grid.ColumnSpan="2" Grid.RowSpan="3" Width="12" Height="12"
                HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="ResizeNW" />
        <Border Grid.ColumnSpan="2" Grid.RowSpan="3" Width="12" Height="12"
                HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="ResizeNE" />
        <Border Grid.ColumnSpan="2" Grid.RowSpan="3" Width="12" Height="12"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="ResizeSW" />
        <Border Grid.ColumnSpan="2" Grid.RowSpan="3" Width="12" Height="12"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="ResizeSE" />

        <Border x:Name="BottomNavigationPanel" Grid.Row="2" IsVisible="False">
            <Grid ColumnDefinitions="*,*,*,*">
                <Button x:Name="BottomHomeNav" Grid.Column="0" Classes="deytt-button" />
                <Button x:Name="BottomRoutesNav" Grid.Column="1" Classes="deytt-button" />
                <Button x:Name="BottomProfileNav" Grid.Column="2" Classes="deytt-button" />
                <Button x:Name="BottomSettingsNav" Grid.Column="3" Classes="deytt-button" />
            </Grid>
        </Border>

        <Grid x:Name="ModalOverlayHost" Grid.ColumnSpan="2" Grid.RowSpan="3"
              Panel.ZIndex="1000" IsVisible="False" />
    </Grid>
</Window>
