<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DeyttConnect.Windows.Controls"
        x:Class="DeyttConnect.Windows.Views.MainWindow"
        Title="deytt./connect"
        WindowDecorations="Full"
        CanResize="True"
        CanMinimize="True"
        CanMaximize="True"
        ShowInTaskbar="True"
        Width="1240"
        Height="720"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#080B12"
        RequestedThemeVariant="Dark">

    <Grid x:Name="ShellGrid" ColumnDefinitions="0,*" RowDefinitions="*,Auto">
        <Grid Grid.ColumnSpan="2" Grid.RowSpan="2" IsHitTestVisible="False">
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#101426" Offset="0" />
                        <GradientStop Color="#080B12" Offset="0.52" />
                        <GradientStop Color="#07100F" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <controls:StarfieldBackground x:Name="AppStarfield" Opacity="0.24" />
        </Grid>

        <Border x:Name="SidebarPanel"
                Grid.Column="0"
                Grid.Row="0"
                IsVisible="False"
                Background="#0D131D"
                BorderBrush="#283548"
                BorderThickness="0,0,1,0"
                Padding="20,23,18,18">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid x:Name="SidebarBrandRow" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <Border x:Name="SidebarBrandMark" Width="42" Height="42"
                            Background="#192331"
                            BorderBrush="#34445B"
                            BorderThickness="1"
                            CornerRadius="15">
                        <TextBlock Text="d"
                                   FontFamily="fonts:DEYTT#Unbounded"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#6BDDF2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="SidebarBrandCopy" Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="deytt./connect"
                                   FontFamily="fonts:DEYTT#JetBrains Mono"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#F2F5FC" />
                        <TextBlock Text="windows client"
                                   FontFamily="fonts:DEYTT#JetBrains Mono"
                                   FontSize="9"
                                   Foreground="#8291A8" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="NavSectionHeader" Grid.Row="1" Margin="2,34,0,12" Spacing="8">
                    <TextBlock x:Name="NavSectionTitle"
                               Text="разделы"
                               FontFamily="fonts:DEYTT#JetBrains Mono"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#8291A8" />
                    <Border Height="1" Background="#202B38" />
                </StackPanel>

                <StackPanel x:Name="SidebarNavPanel" Grid.Row="2" Spacing="5">
                    <Button x:Name="HomeNav" Classes="deytt-button sidebar-nav" />
                    <Button x:Name="RoutesNav" Classes="deytt-button sidebar-nav" />
                    <Button x:Name="ProfileNav" Classes="deytt-button sidebar-nav" />
                    <Button x:Name="SettingsNav" Classes="deytt-button sidebar-nav" />
                </StackPanel>

                <Border x:Name="SidebarStatusCard" Grid.Row="3"
                        Background="#111823"
                        BorderBrush="#283548"
                        BorderThickness="1"
                        CornerRadius="17"
                        Padding="14,13">
                    <StackPanel Spacing="7">
                        <TextBlock Text="состояние"
                                   FontFamily="fonts:DEYTT#JetBrains Mono"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#8291A8" />
                        <Grid ColumnDefinitions="Auto,*">
                            <Ellipse x:Name="SidebarStatusDot"
                                     Width="8" Height="8"
                                     Fill="#9AA8BC"
                                     VerticalAlignment="Center"
                                     Margin="0,0,9,0" />
                            <TextBlock x:Name="SidebarVpnText"
                                       Grid.Column="1"
                                       Text="vpn выключен"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#F2F5FC"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="SidebarAccountText"
                                   Text="telegram не подключён"
                                   FontSize="11"
                                   Foreground="#9AA8BC"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceColumn" Grid.Column="1" Grid.Row="0" RowDefinitions="Auto,*">
            <Border x:Name="WorkspaceHeader" Grid.Row="0"
                    Background="#0A1018"
                    BorderBrush="#202B38"
                    BorderThickness="0,0,0,1"
                    Padding="30,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="WorkspaceEyebrow" Text="deytt · private network"
                                   FontFamily="fonts:DEYTT#JetBrains Mono"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#8291A8" />
                        <TextBlock x:Name="WorkspaceTitle"
                                   Text="ваше подключение"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#F2F5FC" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#111823"
                            BorderBrush="#283548"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,8"
                            VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,Auto">
                            <Ellipse x:Name="HeaderStatusDot"
                                     Width="7" Height="7"
                                     Fill="#9AA8BC"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock x:Name="HeaderStatusText"
                                       Grid.Column="1"
                                       Text="не подключено"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#9AA8BC"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        <ScrollViewer x:Name="PageScroll"
                          Grid.Row="1"
                          BringIntoViewOnFocusChange="True"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="PageHost"
                      MaxWidth="1360"
                      HorizontalAlignment="Center"
                      Margin="34,26,34,42" />
            </ScrollViewer>
        </Grid>

        <Border x:Name="BottomNavigationPanel"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                IsVisible="True"
                Background="#0D131D"
                BorderBrush="#283548"
                BorderThickness="0,1,0,0"
                Padding="6,6,6,8">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="2">
                <Button x:Name="BottomHomeNav" Grid.Column="0" Classes="deytt-button" />
                <Button x:Name="BottomRoutesNav" Grid.Column="1" Classes="deytt-button" />
                <Button x:Name="BottomProfileNav" Grid.Column="2" Classes="deytt-button" />
                <Button x:Name="BottomSettingsNav" Grid.Column="3" Classes="deytt-button" />
            </Grid>
        </Border>

        <Grid x:Name="ModalOverlayHost"
              Grid.ColumnSpan="2"
              Grid.RowSpan="2"
              Panel.ZIndex="1000"
              IsVisible="False" />
    </Grid>
</Window>
