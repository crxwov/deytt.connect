<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeyttConnect.Windows.Views.SupportView">
    <Grid RowDefinitions="Auto,*" Background="#080B12">
        <Border Grid.Row="0"
                Background="#0A1018"
                BorderBrush="#202B38"
                BorderThickness="0,0,0,1"
                Padding="22,17">
            <Grid RowDefinitions="Auto,Auto">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderKicker"
                                   Text="support"
                                   FontFamily="fonts:DEYTT#JetBrains Mono"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#8291A8" />
                        <TextBlock x:Name="HeaderTitle"
                                   Text="поддержка"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#F2F5FC" />
                    </StackPanel>
                    <Button x:Name="RefreshButton"
                            Grid.Column="1"
                            Classes="deytt-button"
                            Margin="0,0,9,0"
                            Padding="13,9"
                            Background="#111823"
                            BorderBrush="#283548"
                            BorderThickness="1"
                            CornerRadius="12"
                            Content="обновить" />
                    <Button x:Name="BackButton"
                            Grid.Column="2"
                            Classes="deytt-button"
                            Padding="13,9"
                            Background="#111823"
                            BorderBrush="#283548"
                            BorderThickness="1"
                            CornerRadius="12"
                            Content="назад" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="SupportNavButton" Classes="deytt-button support-nav" Padding="10,7" />
                    <Button x:Name="TermsNavButton" Classes="deytt-button support-nav" Padding="10,7" />
                    <Button x:Name="PrivacyNavButton" Classes="deytt-button support-nav" Padding="10,7" />
                    <Button x:Name="TelegramNavButton" Classes="deytt-button support-nav" Padding="10,7" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,18,22,20">
            <Grid x:Name="SupportPane" RowDefinitions="Auto,*,Auto" IsVisible="True">
                <Border Grid.Row="0"
                        Background="#111823"
                        BorderBrush="#283548"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,10"
                        Margin="0,0,0,14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Ellipse x:Name="StatusDot"
                                 Width="8"
                                 Height="8"
                                 Fill="#9AA8BC"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0" />
                        <TextBlock x:Name="StatusText"
                                   Grid.Column="1"
                                   Text="загрузка приостановлена"
                                   FontSize="12"
                                   Foreground="#9AA8BC"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button x:Name="RetryButton"
                                Grid.Column="2"
                                Classes="deytt-button"
                                Padding="10,5"
                                Content="повторить"
                                Foreground="#6BDDF2" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="MessageScroll"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              IsVisible="True">
                    <StackPanel x:Name="MessageStack" Spacing="9" />
                </ScrollViewer>

                <Grid x:Name="SignedOutPanel" Grid.Row="1" IsVisible="False">
                    <Border Background="#111823"
                            BorderBrush="#283548"
                            BorderThickness="1"
                            CornerRadius="22"
                            Padding="30"
                            MaxWidth="580"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="12">
                            <TextBlock Text="аккаунт telegram"
                                       FontSize="21"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SignInDescription"
                                       Text="подключите telegram, чтобы написать команде и посмотреть историю обращений."
                                       FontSize="14"
                                       Foreground="#9AA8BC"
                                       TextWrapping="Wrap" />
                            <Button x:Name="SignInButton"
                                    Classes="deytt-button"
                                    HorizontalAlignment="Stretch"
                                    Padding="16,13"
                                    Background="#1B303D"
                                    BorderBrush="#2F5A69"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Content="подключить telegram" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="ComposerCard"
                        Grid.Row="2"
                        Background="#111823"
                        BorderBrush="#283548"
                        BorderThickness="1"
                        CornerRadius="19"
                        Padding="15,13"
                        Margin="0,14,0,0">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="ComposerLabel"
                                   Text="сообщение команде"
                                   FontFamily="fonts:DEYTT#JetBrains Mono"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#8291A8"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CharacterCount"
                                   Grid.Column="1"
                                   Text="0 / 4000"
                                   FontFamily="fonts:DEYTT#JetBrains Mono"
                                   FontSize="9"
                                   Foreground="#8291A8"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="Composer"
                                 Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Margin="0,9,0,10"
                                 MinHeight="76"
                                 MaxHeight="118"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxLength="4000"
                                 PlaceholderText="опишите вопрос минимум в пяти символах"
                                 Background="#192331"
                                 BorderBrush="#283548"
                                 BorderThickness="1"
                                 CornerRadius="13"
                                 Padding="12,10"
                                 FontSize="14"
                                 Foreground="#F2F5FC" />
                        <StackPanel Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button x:Name="CloseTicketButton"
                                    Classes="deytt-button"
                                    Padding="13,9"
                                    Background="#192331"
                                    BorderBrush="#283548"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Content="закрыть обращение"
                                    IsVisible="False" />
                            <Button x:Name="SendButton"
                                    Classes="deytt-button"
                                    Padding="16,9"
                                    Background="#1B303D"
                                    BorderBrush="#2F5A69"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Content="отправить · ctrl+enter" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="DocumentPane" RowDefinitions="Auto,*" IsVisible="False">
                <Border Grid.Row="0"
                        Background="#111823"
                        BorderBrush="#283548"
                        BorderThickness="1"
                        CornerRadius="17"
                        Padding="17,13"
                        Margin="0,0,0,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="DocumentTitle"
                                       Text="условия использования"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="DocumentStatus"
                                       Text="загрузка приостановлена"
                                       FontSize="11"
                                       Foreground="#9AA8BC"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="DocumentRetryButton"
                                Grid.Column="1"
                                Classes="deytt-button"
                                Padding="12,8"
                                Content="повторить"
                                Foreground="#6BDDF2"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Background="#111823"
                            BorderBrush="#283548"
                            BorderThickness="1"
                            CornerRadius="19"
                            Padding="24,22">
                        <StackPanel x:Name="DocumentStack" Spacing="10" />
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
