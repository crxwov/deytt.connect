<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.11.143</Version>
    <AssemblyVersion>0.11.143.0</AssemblyVersion>
    <FileVersion>0.11.143.0</FileVersion>
    <InformationalVersion>0.11.143</InformationalVersion>
    <AssemblyTitle>deytt./connect VPN Service</AssemblyTitle>
    <Company>deytt.</Company>
    <Product>deytt./connect</Product>
    <Description>VPN tunnel service for deytt./connect</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DeyttConnect.Windows.Service</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeyttConnect.Protocol\DeyttConnect.Protocol.csproj" />
    <Compile Include="..\DeyttConnect.Shared\WindowsAwgProfileParser.cs" Link="Shared\WindowsAwgProfileParser.cs" />
    <Content Include="..\..\.toolchain\libxray-v26.10.21\windows\xray.exe" Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))) or $(RuntimeIdentifier.StartsWith('win'))"
           Link="xray.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequirePinnedXray" BeforeTargets="PrepareForBuild" Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))) or $(RuntimeIdentifier.StartsWith('win'))">
    <Error Condition="!Exists('..\..\.toolchain\libxray-v26.10.21\windows\xray.exe')"
           Text="Pinned xray.exe is missing." />
  </Target>
</Project>
